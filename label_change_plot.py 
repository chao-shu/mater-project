class FeatureMLP(nn.Module):
    def __init__(self):
        super(FeatureMLP, self).__init__()
        self.fc1 = nn.Linear(31,16)
        self.relu1 = nn.ReLU()

        self.fc2 = nn.Linear(16, 8)
        self.relu2 = nn.ReLU()

        self.fc3 = nn.Linear(8, 3)


    def forward(self, x):
        x = self.relu2(self.fc2(self.relu1(self.fc1(x))))
        logits = self.fc3(x)
        return logits
    
