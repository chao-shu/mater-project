import pandas as pd
import matplotlib.pyplot as plt
from collections import Counter

def smooth_labels_by_voting(df, window=2):
    smoothed = []

    for video, group in df.groupby("video"):
        group = group.sort_values("frame").reset_index(drop=True)
        labels = group["label"].tolist()
        frames = group["frame"].tolist()

        smoothed_labels = []

        for i in range(len(labels)):
            # Get window of labels: [i-2, i-1, i, i+1, i+2]
            start = max(0, i - window)
            end = min(len(labels), i + window + 1)
            window_labels = labels[start:end]

            # Majority vote
            most_common_label = Counter(window_labels).most_common(1)[0][0]
            smoothed_labels.append(most_common_label)

        group["label"] = smoothed_labels
        smoothed.append(group)

    return pd.concat(smoothed, ignore_index=True)

def plot_fuc(path):
    # Load CSV
    df = pd.read_csv(path, header=None, names=['video', 'frame', 'label'])

    # Smooth labels with context ±2 voting
    df = smooth_labels_by_voting(df, window=2)

    # Group by frame and calculate label proportions
    label_proportions = df.groupby(['frame', 'label']).size().unstack(fill_value=0)
    label_proportions = label_proportions.div(label_proportions.sum(axis=1), axis=0)

    # Plot
    plt.figure(figsize=(12, 6))
    label_proportions.plot(kind='area', stacked=True, colormap='tab10', figsize=(14, 6))
    plt.title("Label Proportions per Frame (Smoothed with ±2 Voting)")
    plt.xlabel("Frame Number")
    plt.ylabel("Proportion")
    plt.legend(title="Label", bbox_to_anchor=(1.05, 1), loc='upper left')
    plt.tight_layout()
    plt.show()

def predicted_GT_comparison(predicted_path, GT_path):
    predicted_df = pd.read_csv(predicted_path, header=None, names=['video', 'frame', 'label'])
    GT_df = pd.read_csv(GT_path, header=None, names=['video', 'frame', 'label'])

    predicted_df = smooth_labels_by_voting(predicted_df, window=2)
    # Rename for clarity
    predicted_df = predicted_df.rename(columns={'label': 'pred'})
    GT_df = GT_df.rename(columns={'label': 'true'})
    
    GT_df['frame'] = GT_df['frame'] - 1
    # Merge on video and frame
    merged = pd.merge(GT_df, predicted_df, on=['video', 'frame'], how='inner')
    print(len(predicted_df),len(GT_df),len(merged))
    # Calculate accuracy
    correct = (merged['true'] == merged['pred']).sum()
    total = len(merged)
